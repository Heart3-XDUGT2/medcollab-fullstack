          },
          "memberCount": {
            "type": "integer"
          },
          "role": {
            "enum": [
              "leader",
              "member",
              "none"
            ]
          },
          "createdAt": {
            "type": "string"
          }
        }
      },
      "Member": {
        "type": "object",
        "required": [
          "subject",
