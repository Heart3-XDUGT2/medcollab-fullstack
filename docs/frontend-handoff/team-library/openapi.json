              "member"
            ]
          },
          "joinedAt": {
            "type": "string"
          }
        }
      },
      "TeamDataset": {
        "type": "object",
        "required": [
          "id",
          "name",
          "access",
          "ownerUsername",
          "instanceCount",
          "createdAt",
          "scope",
          "teamId",
          "uploaderSubject",
          "canDelete"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "access": {
            "enum": [
              "owner",
              "shared"
            ]
          },
          "ownerUsername": {
            "type": "string"
          },
          "instanceCount": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string"
          },
          "scope": {
            "const": "team"
          },
          "teamId": {
            "type": "string"
          },
          "uploaderSubject": {
            "type": "string"
          },
          "canDelete": {
            "type": "boolean"
          }
